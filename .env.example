# Copy to .env.local for `npm run dev`, and add the same names in Vercel (Settings > Environment Variables).

# Which data layer the browser uses. "server" calls /api/rpc (Supabase behind it).
# Leave unset for the offline demo that keeps everything in the browser.
VITE_STRIDE_BACKEND=server

# Supabase > Project Settings > API. The service role key stays on the server; never prefix it with VITE_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# "true" lets anyone use Account > Reset demo data, which wipes and reseeds the database.
# Leave it off once real families use the app.
STRIDE_ALLOW_RESET=true
